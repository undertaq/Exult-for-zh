# Copy this file to .env and fill in your values.
# Used by Python scripts (generate_voices.py, suggest_voices.py, etc.)
# and by the voice_casting_tool web app.

# Required for voice generation and the casting tool's voice browser.
# Get one at https://elevenlabs.io
ELEVENLABS_API_KEY=

# Required for voice_casting_tool/scripts/suggest_voices.py only.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Path to the generation manifest CSV. The casting tool loads
# NPC dialog from here. Defaults to ./csvs/manifest.csv if unset.
# Use absolute paths or paths relative to wherever you start the app.
#MANIFEST_CSV=/absolute/path/to/csvs/manifest.csv

# Optional. Directory holding generated voice WAV files. When set, the
# casting tool shows "play from disk" buttons so you can audition real
# generated audio. When unset, only the ElevenLabs preview samples play.
# Linux/macOS example: /home/you/.local/share/exult/voice_acting
# Windows example:     C:/Program Files (x86)/GOG Galaxy/Games/Ultima 7/patch/voice_acting
#VOICE_WAV_DIR=
